# ---- Dependencies --------------------------------------------------------
node_modules/
package-lock.json
__pycache__/

# ---- Shared template workbook (copied in locally, not redistributed) -----
common/

# ---- Per-challenge working folders (outputs/{theme}/) --------------------
# Only discussion.md, requirements-{ja,en}.md and x-post.txt are tracked.
# tmp/       intermediates, scripts, screenshots, blog notes
# prototype/ draft HTML
# refine/    refine loop: working .twbx, wb-build, compare page, Cloud renders, publish results
outputs/*/tmp/
outputs/*/prototype/
outputs/*/refine/
# Non-public per-challenge assets
**/Archived/
# Third-party datasets (license-bound; fetch via the documented steps)
outputs/*/Dataset/
outputs/*/data/
**/data_points.json
**/dc_grocery.json
# Workbook extraction byproducts
**/.tmp_twb/
**/twbx-extracted/
**/twbx-tc25/

# ---- Tableau files -------------------------------------------------------
# Workbooks are published to Tableau Cloud / Public; no need to mirror them here
*.twbx
# Tableau Desktop auto-recovery files
*.twbr
# Renders, screenshots and viz exports
*.png

# ---- Skill caches --------------------------------------------------------
# create-workbook: local snapshot of tableau-document-schemas (fetched by update-schemas.ts)
.claude/skills/create-workbook/references/schemas/

# ---- Local settings, secrets and tool state ------------------------------
.claude/settings.json
.env
.env.*
!.env.example
.auth-cache/
*.pem
*.key
.playwright-mcp/
*.log

# ---- OS ------------------------------------------------------------------
.DS_Store
Thumbs.db
# A stray "nul" file appears when a Windows-style "> nul" redirect runs in a POSIX shell
nul
