# ---- Dependencies --------------------------------------------------------
node_modules/
package-lock.json
__pycache__/

# ---- Shared template workbook (copied in locally, not redistributed) -----
common/

# ---- Per-challenge folders (outputs/{theme}/) ----------------------------
# Allowlist: everything in a theme folder is ignored unless listed below.
# Anything else that should be public goes under outputs/{theme}/public/.
# Files tracked before this rule stay tracked.
outputs/*/*
!outputs/*/discussion.md
!outputs/*/requirements-ja.md
!outputs/*/requirements-en.md
!outputs/*/x-post.txt
!outputs/*/guide/
outputs/*/guide/*
!outputs/*/guide/build-guide.html
!outputs/*/public/
# Non-public per-challenge assets (also outside outputs/)
**/Archived/
# Third-party datasets (license-bound; fetch via the documented steps)
outputs/*/Dataset/
outputs/*/data/
**/data_points.json
**/dc_grocery.json
# Workbook extraction byproducts
**/.tmp_twb/
**/twbx-extracted/
**/twbx-tc25/

# ---- Tableau files -------------------------------------------------------
# Workbooks are published to Tableau Cloud / Public; no need to mirror them here
*.twbx
# Tableau Desktop auto-recovery files
*.twbr
# Renders, screenshots and viz exports
*.png

# ---- Skill caches --------------------------------------------------------
# create-workbook: local snapshot of tableau-document-schemas (fetched by update-schemas.ts)
.claude/skills/create-workbook/references/schemas/

# ---- Local settings, secrets and tool state ------------------------------
.claude/settings.local.json
.env
.env.*
!.env.example
.auth-cache/
*.pem
*.key
.playwright-mcp/
*.log

# ---- OS ------------------------------------------------------------------
.DS_Store
Thumbs.db
# A stray "nul" file appears when a Windows-style "> nul" redirect runs in a POSIX shell
nul
