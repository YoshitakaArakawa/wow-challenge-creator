**/twbx-tc25/

# Image outputs (Tableau renders, screenshots, viz exports)
*.png

# Tableau workbooks (published on Tableau Public — no need to mirror in repo)
*.twbx

# Local Claude Code settings (per-user, not shared)
.claude/settings.json

# OS
.DS_Store
Thumbs.db

# Environment / secrets
.env
.auth-cache/
