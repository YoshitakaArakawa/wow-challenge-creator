# Tableau Cloud settings shared by publish-to-cloud (Python) and analyze-twbx (TS).
# Copy this file to `.env` and fill in your values. The real `.env` is gitignored.

# Tableau Cloud URL (pod host). Example: https://10ax.online.tableau.com
TABLEAU_SERVER_URL=

# Site content URL (the part after /site/ in the Cloud URL). Empty string means default site.
TABLEAU_SITE_ID=

# Default project to publish into. Must be unique by name on the site.
TABLEAU_PROJECT_NAME=99_WorkoutWednesday

# --- Authentication ---
# Default: OAuth 2.0 (PKCE) browser sign-in. No token needed here; the session is cached in .auth-cache/.
# Loopback port for the OAuth callback (optional).
OAUTH_CALLBACK_PORT=8765

# Optional: set both to use a Personal Access Token instead of the browser sign-in.
TABLEAU_PAT_NAME=
TABLEAU_PAT_VALUE=
